rules_version = '2';

// All reads/writes go through Cloud Functions using the Admin SDK, which
// bypasses these rules entirely. This default-deny is defense in depth in
// case direct client-side Firestore access is ever added later — if that
// happens, replace this with rules scoped to the specific new access pattern.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
